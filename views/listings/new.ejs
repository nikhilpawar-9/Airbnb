<% layout('layouts/boilerplate') %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3>Create New Listing</h3>
    <form action="/listings" method="POST" novalidate class ="needs-validation">
        <div class="mb-3 mt-1">
            <label for="title" class="form-label">Title:</label>
            <input type="text" placeholder="Add a catchy" id="title" name="listing[title]" class="form-control" required>
            <div class="invalid-feedback">
                Please provide a title.
            </div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description:</label>
            <textarea id="description" placeholder="" name="listing[description]" class="form-control" required></textarea>
            <div class="invalid-feedback">
                Please provide a description.
            </div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Image URL:</label>
            <input type="url" placeholder="enter image URL/Link" id="image" name="listing[image][url]" class="form-control">
        </div>

        <div class="row">
            <div class="mb-3 col-4 md-4">
            <label for="price" class="form-label">Price:</label>
            <input type="text" placeholder="1200" id="price" name="listing[price]" step="0.01" class="form-control" required>
            <div class="invalid-feedback">
                Please provide a price.
            </div>
            </div>

            <div class="mb-3 col-4 md-4">
            <label for="maxGuests" class="form-label">Max Guests:</label>
            <input type="number" placeholder="4" id="maxGuests" name="listing[maxGuests]" class="form-control" min="1" value="2" required>
            <div class="invalid-feedback">
                Please provide a maximum number of guests.
            </div>
            </div>

            <div class="mb-3 col-8 md-8">
            <label for="country" class="form-label">Country:</label>
            <input type="text" placeholder="India" id="country" name="listing[country]" class="form-control" required>
            <div class="invalid-feedback">
                Please provide a country.
            </div>
            </div>
        </div>

        <div class="mb-3">
            <label for="location" class="form-label">Location:</label>
            <input type="text" placeholder="Mumbai" id="location" name="listing[location]" class="form-control" required>
            <div class="invalid-feedback">
                Please provide a location.
            </div>
        </div>
        <button type="submit" class="btn btn-dark add-btn mt-3 mb-4">Add</button>        
    </form>
</div>
</div>
