<% layout('layouts/boilerplate') %>
<div class="show-page">
    <h2 class="show-title">Listing Details</h2>

    <div class="show-image-card">
        <img src="<%= listing.image.url %>" class="show-image" alt="Listing image">
    </div>

    <b><div class="show-image-label"><%= listing.title %></div></b>

    <ul class="show-list">
        <li><%= listing.description %>.</li>
        <li><%= listing.price.toLocaleString() %></li>
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
    </ul>
    
    <div class="show-actions mt-3">
        <a href="/listings/<%= listing._id %>/edit" class="show-edit-btn">Edit</a>

        <form action="/listings/<%= listing._id %>/delete?_method=DELETE" method="POST" class="show-delete-form">
            <button type="submit" class="show-delete-btn">Delete</button>
        </form>
    </div>
    <br>
</div>